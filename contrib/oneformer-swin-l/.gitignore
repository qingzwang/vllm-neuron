__pycache__/

# neuronx-cc drops these next to the working directory when it compiles: one
# directory per private NKI kernel it caches, plus a metrics file. The
# neuronxcc-* scratch directory is normally cleaned up, but not when the
# compiler is killed -- and it is 233 MB.
/c[0-9a-f]*/
/global_metric_store.json
/neuronxcc-*/
